# Copy to .env and fill in the two required values. Everything else is
# optional and defaults to the offline demo.

# =============================================================================
# Required
# =============================================================================

# The default model for every agent role (the `claude` gateway alias).
ANTHROPIC_API_KEY=

# Lenses HQ will not start until you accept its EULA.
ACCEPT_EULA=true

# =============================================================================
# Models (optional)
# =============================================================================

# Only needed if you route a role to a mistral-* or gpt alias in the
# dashboard's Models panel. Aliases are defined in agent/gateway/litellm.yaml.
MISTRAL_API_KEY=
OPENAI_API_KEY=

# The gateway's master key; the agent presents the same default.
# LITELLM_MASTER_KEY=sk-kafka-sre-demo

# Default alias per role. The dashboard's Models panel and the operator
# console change them on the running agent server until it restarts; the CLI
# always uses these.
# SUPERVISOR_MODEL=claude
# TRIAGE_MODEL=claude
# DIAGNOSIS_MODEL=claude
# FORENSICS_MODEL=claude
# REPORTER_MODEL=claude

# Hard cap on the forensics agent's GitHub calls per investigation (0 = none).
# FORENSICS_TOOL_BUDGET=14

# =============================================================================
# Integrations: stub (bundled fixtures, the default) or live
# =============================================================================
# Switch one server at a time; docs/going-live.md has each one's setup.

PAGERDUTY_MODE=stub
GITHUB_MODE=stub
CONFLUENCE_MODE=stub
SLACK_MODE=stub

# --- PagerDuty --------------------------------------------------------------
# A User API Token (My Profile -> User Settings -> Create API User Token).
# `make pd-setup` creates the demo services and prints their ids.
PAGERDUTY_API_KEY=
# PAGERDUTY_SERVICE_IDS=        # without it, every open incident is auto-run
# PAGERDUTY_POLL_S=5            # 0 turns the poller off
# PAGERDUTY_ESCALATION_POLICY=  # policy name for `make pd-setup` (default: the first)
# EU accounts:
# PAGERDUTY_API_URL=https://api.eu.pagerduty.com
# PAGERDUTY_MCP_URL=https://mcp.eu.pagerduty.com/mcp

# --- GitHub -----------------------------------------------------------------
# The agent's read-only token: a fine-grained PAT on the org with
# Contents: read + Pull requests: read.
GITHUB_TOKEN=
# GITHUB_ORG=dss26-org
# GITHUB_API_URL=https://api.github.com   # or https://ghe.example.com/api/v3
#
# The incident scripts' write token, used to merge the culprit PR and its
# revert (Contents + Pull requests: read/write). Falls back to `gh auth token`.
# GITHUB_SCENARIO_TOKEN=
# GITHUB_SCENARIO=auto          # on | off | auto (on when live and a token exists)

# --- Confluence Cloud -------------------------------------------------------
# The site's wiki root (https://your-site.atlassian.net/wiki) and an API
# token from id.atlassian.com -> Security -> API tokens.
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# CONFLUENCE_SPACE=             # space to search and publish in
# CONFLUENCE_PARENT_PAGE_ID=    # file RCAs under this page
# Publishing stays a dry run (credential and space checked, no page created)
# until you set this to false.
CONFLUENCE_DRY_RUN=true

# --- Slack ------------------------------------------------------------------
# Bot token (xoxb-...) from the app in agent/integrations/slack-app-manifest.yaml.
SLACK_BOT_TOKEN=
# Pin every post to one channel, or let the model choose from a list.
# SLACK_DEFAULT_CHANNEL=#sre-agent-sandbox
# SLACK_CHANNEL_ALLOWLIST=sre-agent-sandbox,bots
# SLACK_DEDUPE_TTL_S=86400
# Posting stays a dry run (token and workspace checked, nothing sent) until
# you set this to false.
SLACK_DRY_RUN=true

# =============================================================================
# Lenses (optional)
# =============================================================================

# Your own license key; blank uses the Community Edition key in compose.
LENSES_LICENSE_KEY=
# Where host-side runs (make run, the scripts) reach HQ and MCP.
# LENSES_HQ_URL=http://localhost:9991
# LENSES_MCP_URL=http://localhost:8000

# Phoenix project the agent's traces land in. Spans name the model and vendor
# behind each gateway alias on their own (agent/gateway/litellm.yaml).
# PHOENIX_PROJECT_NAME=kafka-sre-agent
